@inject StringsService Str

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6" Class="mb-5">@Str.Get("help", "title")</MudText>

        <div class="d-flex align-start gap-3 mb-4">
            <MudIcon Icon="@Icons.Material.Outlined.Thermostat" Color="Color.Primary" Style="margin-top: 2px; flex-shrink: 0;" />
            <div>
                <div style="font-weight: 600; margin-bottom: 2px;">@Str.Get("help", "housing_title")</div>
                <MudText Typo="Typo.body2" Style="opacity: 0.75;">@Str.Get("help", "housing_body")</MudText>
            </div>
        </div>

        <div class="d-flex align-start gap-3 mb-4">
            <MudIcon Icon="@Icons.Material.Outlined.WbSunny" Color="Color.Warning" Style="margin-top: 2px; flex-shrink: 0;" />
            <div>
                <div style="font-weight: 600; margin-bottom: 2px;">@Str.Get("help", "daytime_title")</div>
                <MudText Typo="Typo.body2" Style="opacity: 0.75;">@Str.Get("help", "daytime_body")</MudText>
            </div>
        </div>

        <div class="d-flex align-start gap-3 mb-4">
            <MudIcon Icon="@Icons.Material.Outlined.NightsStay" Color="Color.Secondary" Style="margin-top: 2px; flex-shrink: 0;" />
            <div>
                <div style="font-weight: 600; margin-bottom: 2px;">@Str.Get("help", "night_title")</div>
                <MudText Typo="Typo.body2" Style="opacity: 0.75;">@Str.Get("help", "night_body")</MudText>
            </div>
        </div>

        <div class="d-flex align-start gap-3">
            <MudIcon Icon="@Icons.Material.Outlined.Speed" Color="Color.Error" Style="margin-top: 2px; flex-shrink: 0;" />
            <div>
                <div style="font-weight: 600; margin-bottom: 2px;">@Str.Get("help", "risk_title")</div>
                <MudText Typo="Typo.body2" Style="opacity: 0.75;">@Str.Get("help", "risk_body")</MudText>
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton FullWidth Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@(() => MudDialog.Close())">@Str.Get("help", "close_button")</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = null!;
}
